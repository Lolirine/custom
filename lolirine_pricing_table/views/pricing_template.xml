<odoo>
  <template id="pricing_template" name="Tarifs Garde-Meubles">
    <t t-call="website.layout">
      <section class="oe_structure" style="background-color:#FAF4EF; padding: 50px 0;">
        <div class="container">
          <h2 class="text-center mb-4" style="color:#B86B55; font-weight:700; font-size:2.2rem;">Tarifs Garde-Meubles</h2>
          <div class="table-responsive">
            <table class="table table-bordered shadow-sm">
              <thead style="background-color:#E5C4A0; color:#3B2F2F;">
                <tr>
                  <th>Type de box</th>
                  <th>Prix mensuel</th>
                  <th>Frais de dossier</th>
                  <th>Caution</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="products" t-as="product">
                  <tr>
                    <td><t t-esc="product.name"/></td>
                    <td><t t-esc="product.list_price"/> €</td>
                    <td><t t-esc="product.x_frais_dossier or '—'"/> €</td>
                    <td><t t-esc="product.x_caution or '—'"/> €</td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-muted text-center">💡 Les frais de dossier sont à régler une seule fois lors de l'entrée. La caution est restituée à la sortie après vérification du box.</p>
        </div>
      </section>
    </t>
  </template>
</odoo>
